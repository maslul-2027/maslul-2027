# /etc/maslul/maslul.env  (mode 0640 root:maslul; read by systemd EnvironmentFile AND sourced by backup.sh, so values with spaces are double-quoted) — PLACEHOLDERS ONLY. install.sh writes the real values on the server; never commit real ones.
# SYNTHETIC DATA ONLY. The service refuses to start without the acknowledgement below.
MASLUL_SYNTHETIC_ONLY_ACK=yes
# Private DNS name of the TEST (a name under a domain the organisation controls; resolves to the WireGuard address below).
MASLUL_NAME=maslul-test.example.com
# Bind ONLY the WireGuard address (RFC1918). The app refuses public, wildcard, CGNAT and DNS-name binds (backend_next/private_net.js).
MASLUL_BIND=10.8.0.1
MASLUL_PORT=8443
# State (encrypted store, files, secrets.json) lives here; owned by the service user, mode 0700.
MASLUL_DATA_DIR=/var/lib/maslul
# Certificate chain + key for MASLUL_NAME (Let's Encrypt via DNS-01, see issue-cert.sh). The app refuses a cert whose SAN lacks the name or that expires within an hour.
MASLUL_TLS_CERT=/etc/maslul/tls/fullchain.pem
MASLUL_TLS_KEY=/etc/maslul/tls/privkey.pem
# One-time first admin (synthetic). Only used while the store has no users; install.sh removes the PIN line after the first successful start.
MASLUL_SEED_ADMIN_NAME="מנהל בדיקות (סינתטי)"
MASLUL_SEED_ADMIN_PHONE=0500000001
MASLUL_SEED_ADMIN_PIN=CHANGE_ME_ON_SERVER
# Backups
BACKUP_DIR=/var/backups/maslul
BACKUP_KEEP=14
# Optional second location (another machine/bucket). Placeholder: leave empty until IT approves a destination.
BACKUP_REMOTE=
# age public key (recipient) used to encrypt secrets.json for the off-box copy. Placeholder.
BACKUP_AGE_RECIPIENT=
